// A comet with a fading tail, bouncing between the ends
effect "Comet" {
  speed = slider("Speed", 128)
  tail = slider("Tail", 128)
  var pos = 0
  var dir = 1

  fn frame() {
    fade((255 - tail) / 6)
    pos += dir * speed / 256
    if pos >= len - 1 { pos = len - 1; dir = -1 }
    if pos <= 0 { pos = 0; dir = 1 }
    set(pos, color(0))
  }
}
